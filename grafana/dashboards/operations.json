{
  "uid": "operations",
  "title": "MAYSS Operations",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Корзин активных",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(DISTINCT user_id) AS value FROM cart_items",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Товаров в корзинах",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT COALESCE(sum(quantity), 0) AS value FROM cart_items",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Стоимость корзин",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT COALESCE(round(sum(ci.quantity * p.price)::numeric, 2), 0) AS value FROM cart_items ci JOIN products p ON p.id = ci.product_id",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "currencyRUB"
        }
      }
    },
    {
      "type": "stat",
      "title": "Избранное (всего)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM favorites",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Открытых тикетов",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM support_tickets WHERE lower(status::text) = 'open'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Товаров на модерации",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM products WHERE lower(status::text) = 'pending'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Товаров без остатка",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM products WHERE lower(status::text) = 'active' AND stock = 0",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Низкие остатки (≤5)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM products WHERE lower(status::text) = 'active' AND stock > 0 AND stock <= 5",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Адресов сохранено",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM addresses",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Карт привязано",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM cards",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Отзывов всего",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM reviews",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Средний рейтинг",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT COALESCE(round(avg(rating)::numeric, 2), 0) AS value FROM reviews",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Заказы и отмены по дням",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', created_at) AS \"time\", count(*) FILTER (WHERE lower(status::text) NOT IN ('created','cancelled')) AS \"Активные\", count(*) FILTER (WHERE lower(status::text) = 'cancelled') AS \"Отменены\" FROM orders GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Отзывы по дням",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', created_at) AS \"time\", count(*) AS \"Отзывов\", round(avg(rating)::numeric, 2) AS \"Средняя оценка\" FROM reviews GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Распределение оценок",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT rating::text || ' звёзд' AS \"Оценка\", count(*) AS \"Кол-во\" FROM reviews GROUP BY rating ORDER BY rating DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Тикеты по статусу",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT status AS \"Статус\", count(*) AS \"Кол-во\" FROM support_tickets GROUP BY status",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Топ товаров в корзинах",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT p.title AS \"Товар\", sum(ci.quantity) AS \"В корзинах\" FROM cart_items ci JOIN products p ON p.id = ci.product_id GROUP BY p.title ORDER BY 2 DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Товары без остатка",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT p.title AS \"Товар\", sp.shop_name AS \"Магазин\", p.price AS \"Цена\" FROM products p JOIN seller_profiles sp ON sp.id = p.seller_id WHERE lower(p.status::text) = 'active' AND p.stock = 0 ORDER BY p.title LIMIT 30",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Очередь модерации товаров",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT p.id AS \"#\", p.title AS \"Товар\", sp.shop_name AS \"Магазин\", p.price AS \"Цена\", p.created_at AS \"Создан\" FROM products p JOIN seller_profiles sp ON sp.id = p.seller_id WHERE lower(p.status::text) = 'pending' ORDER BY p.created_at ASC LIMIT 30",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Тикеты в работе",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT st.id AS \"#\", u.email AS \"Пользователь\", st.subject AS \"Тема\", st.status AS \"Статус\", st.created_at AS \"Создан\" FROM support_tickets st JOIN users u ON u.id = st.user_id WHERE st.status != 'closed' ORDER BY st.created_at DESC LIMIT 30",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Низкие остатки (≤5)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT p.title AS \"Товар\", sp.shop_name AS \"Магазин\", p.stock AS \"Остаток\" FROM products p JOIN seller_profiles sp ON sp.id = p.seller_id WHERE lower(p.status::text) = 'active' AND p.stock > 0 AND p.stock <= 5 ORDER BY p.stock ASC LIMIT 30",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
